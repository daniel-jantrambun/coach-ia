# Phrase secrète qui chiffre les jetons Garmin en base. À générer une fois, à sauvegarder hors du NAS :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# La perdre (ou la changer) oblige chacun à reconnecter son compte Garmin.
COACH_SECRET_KEY=

# true uniquement si l'app est servie en HTTPS (sinon le cookie de session ne sera pas envoyé)
COACH_COOKIE_SECURE=false

# LLM local (Ollama ou llama.cpp server, API compatible OpenAI)
COACH_LLM_MODEL=qwen2.5:3b
